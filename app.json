{
  "expo": {
    "name": "Thingual",
    "slug": "thingual",
    "scheme": "thingual",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Learn languages step by step: a Duolingo-style path from A1 to C2 in 16 languages, with lessons, hearts, streaks and threads where learners write to each other and fix each other's mistakes.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#04131C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.thingual",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose a photo for your post, profile picture or a word card.",
        "NSMicrophoneUsageDescription": "Thingual listens when you practise pronunciation or talk to the AI partner.",
        "NSSpeechRecognitionUsageDescription": "Speech recognition checks your pronunciation and turns your voice into text in conversation practice.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.thingual",
      "adaptiveIcon": {
        "backgroundColor": "#04131C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Thingual",
      "themeColor": "#04131C",
      "backgroundColor": "#FAFAF8"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#04131C"
        }
      ],
      "expo-image",
      "expo-localization",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your post, profile picture or a word card.",
          "cameraPermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Thingual listens when you practise pronunciation or talk to the AI partner.",
          "speechRecognitionPermission": "Speech recognition checks your pronunciation and turns your voice into text in conversation practice.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FF6B35"
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": true,
          "microphonePermission": "Thingual records your voice when you make a voice postcard."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
